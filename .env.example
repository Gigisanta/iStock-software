# ============================================================================
# iStock — variables de entorno.  cp .env.example .env.local
# Regla dura: NEXT_PUBLIC_* se audita a mano. Nada que no sea publico va con
# ese prefijo. Si agregas una NEXT_PUBLIC_*, justificala en el PR.
# ============================================================================

# --- Base de datos -----------------------------------------------------------
# Dev sin B2: ./scripts/pg-local.sh  (Postgres local con auth.jwt() emulada)
# Sin usuario en la URL a proposito: libpq cae al usuario del SO, que es el unico rol que
# `scripts/pg-local.sh` garantiza. Ese script NO crea un rol `postgres` — decia eso aca y
# le costo una corrida entera a un agente (`role "postgres" does not exist`).
DATABASE_URL="postgresql://localhost:5432/istock_dev"

# --- B2 · Supabase  (humano) -------------------------------------------------
# SPEND CAP ON. Ver docs/README de operador antes de tocarlo.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""          # server-only. Jamas NEXT_PUBLIC_.

# --- Auth del panel ----------------------------------------------------------
# "local" = driver de dev, sin B2, firma la sesion con AUTH_LOCAL_SECRET.
# env.ts REVIENTA el arranque si AUTH_DRIVER="local" en produccion: no es una
# convencion, es un assert. Sin B2 el panel corre igual con "local".
AUTH_DRIVER="local"                   # local | supabase
# Sin esto el driver local firma con un secret de dev HARDCODEADO. Para correr en
# tu maquina alcanza; cualquier cosa que no sea tu maquina, no.
#   openssl rand -hex 32
AUTH_LOCAL_SECRET=""                  # >= 16 chars

# --- B1 · Cloudflare R2  (humano) --------------------------------------------
# Sin esto, packages/media usa el adapter local en disco (dev) y S2 corre igual.
MEDIA_DRIVER="local"                  # local | r2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_ORIGINALS="istock-originals" # PRIVADO. El master no se sirve nunca.
R2_BUCKET_MEDIA="istock-media"         # publico, solo variantes.
NEXT_PUBLIC_MEDIA_BASE_URL="http://localhost:3000/_media"  # prod: https://img.maat.work

# --- B3 · Mercado Pago  (humano, sandbox) ------------------------------------
# Sin esto, billing corre con el driver mock y el trial de 14d funciona igual.
BILLING_DRIVER="mock"                 # mock | mercadopago
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""                  # HMAC. La verificacion vive DENTRO del route handler.
MP_PREAPPROVAL_PLAN_BASE=""
MP_PREAPPROVAL_PLAN_NEGOCIO=""

# --- B4 · LLM de vidriera  (humano) ------------------------------------------
# IDs por env, NUNCA constante en codigo (ADR/R3: llama-3.1-8b-instant esta retirado).
LLM_PRIMARY_MODEL="gemini-2.5-flash-lite"
LLM_FALLBACK_MODEL="openai/gpt-oss-20b"
GOOGLE_GENERATIVE_AI_API_KEY=""       # billing HABILITADO desde el dia 1 (privacidad, no costo)
GROQ_API_KEY=""                       # ZDR activado antes de produccion
LLM_MAX_INPUT_TOKENS="1200"
LLM_MAX_OUTPUT_TOKENS="180"

# --- Hosts -------------------------------------------------------------------
# B5: migrar nameservers de maat.work a Vercel. Dev usa nip.io / .localhost.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"   # prod: maat.work
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Observabilidad (opcional, free tier) ------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""

# --- Cron --------------------------------------------------------------------
CRON_SECRET=""                        # Vercel Cron -> Authorization: Bearer
