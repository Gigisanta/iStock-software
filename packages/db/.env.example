# packages/db — copiar a `.env` (git-ignored). No hay secretos de terceros acá: este paquete
# habla con Postgres y con nadie más.

# Local (Homebrew): la crea `./scripts/pg-local.sh` desde la raíz del repo.
DATABASE_URL=postgresql://postgres@localhost:5432/istock_dev

# Supabase: usar la connection string del POOLER en modo `session` para migrar.
# El modo `transaction` no soporta sentencias preparadas y `drizzle-kit` falla a mitad de camino.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Teléfono del tenant demo. Sin esto el seed usa un placeholder que NO existe en WhatsApp
# (`5492990000000`): sirve para desarrollo, no para mostrarle la demo a un cliente.
# SEED_DEMO_WA_PHONE=549299XXXXXXX
